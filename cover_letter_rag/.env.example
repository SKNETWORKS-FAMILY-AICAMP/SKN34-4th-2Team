# Copy this file to .env and put real secrets only in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

APP_ENV=local

# Firebase Admin uses Application Default Credentials on the backend.
# For local development, set GOOGLE_APPLICATION_CREDENTIALS in your shell to an
# untracked service-account JSON path. Never put that JSON or OpenAI keys in Flutter.
FIREBASE_PROJECT_ID=
FIRESTORE_COHORTS_COLLECTION=cohorts
FIRESTORE_RESUMES_COLLECTION=resumes
FIRESTORE_AI_REVIEWS_COLLECTION=aiReviews

# Optional absolute path to the teammate's full-text SQLite job store.
# If omitted: <repo>/job_matching_bot/artifacts/job_store.sqlite
# MATCHING_JOB_STORE_PATH=C:/path/to/job_store.sqlite
