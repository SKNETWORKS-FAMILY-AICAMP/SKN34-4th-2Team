# 이 파일은 직접 편집하지 않는다.
# 실제 functions/.env 는 scripts/sync-functions-env.ps1 가 루트 .env 에서 생성한다.
# 설정은 전부 루트 .env.example 을 보고 루트 .env 에 채운다.

# ── 여기(functions/.env)에 절대 넣지 않는 키 ─────────────────────────────
# 아래는 Secret Manager 로만 넣는다. 스크립트가 자동으로 제외한다.
# 같은 이름이 일반 env 와 Secret 에 동시에 있으면 Cloud Run 배포가
# "Secret environment variable overlaps non secret environment variable" 400 으로 실패한다.
#
#   firebase functions:secrets:set OPENAI_API_KEY          # syncNoticeVector, generateAssessmentQuestions
#   firebase functions:secrets:set PINECONE_API_KEY2       # syncNoticeVector
#   firebase functions:secrets:set DISCORD_BOT_TOKEN       # syncDiscordNotices
#   firebase functions:secrets:set GOOGLE_FORM_WEBHOOK_SECRET
#
# 등록/변경 뒤에는 해당 함수를 다시 배포해야 새 값을 읽는다.

# ── 스크립트가 루트 .env 에서 복사해 오는 일반 설정 (참고용) ─────────────
DISCORD_COHORT_ID=cohort_34
DATA_GO_KR_SERVICE_KEY=
ASSESSMENT_PROMPT_VERSION=assess_q_v2
