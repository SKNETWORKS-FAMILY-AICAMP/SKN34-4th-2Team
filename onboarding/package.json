{
  "name": "lms-onboarding",
  "private": true,
  "description": "LMS 사용자 온보딩 PDF와 시연 영상을 데모 모드 웹 빌드에서 만든다",
  "type": "module",
  "scripts": {
    "build:web": "cd .. && flutter build web --dart-define=DEMO_MODE=true --output build/onboarding_web",
    "probe": "node probe.mjs",
    "capture": "node capture.mjs",
    "pdf": "node pdf.mjs",
    "record": "node record.mjs",
    "all": "node capture.mjs && node pdf.mjs && node record.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
