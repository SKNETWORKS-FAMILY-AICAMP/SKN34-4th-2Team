flowchart LR
  subgraph PRE["미리 해 두는 일 — 적재 (매일 밤 자동)"]
    A["채용 사이트<br>공식 API 또는 크롤링"] -->|수집| B["원본 레코드"]
    B -->|정제·중복 제거| C["요건 구간만 추출<br>주요업무·자격요건·우대사항"]
    C -->|지문이 바뀐 것만 임베딩| D[("Pinecone<br>벡터 + 메타데이터")]
    B --> S[("job_store.sqlite<br>원문 전체 · 관측 기록 · 지문")]
  end
  subgraph REQ["요청이 올 때 — 추천"]
    R["이력서 + 희망 조건"] --> Q["① 질의문 생성<br>LLM"]
    Q --> V["② 벡터 검색<br>상위 25"]
    V --> H["③ 하드 필터<br>규칙"]
    H --> L["④ LLM 재정렬<br>상위 12"]
    L --> G["⑤ 근거 검증<br>규칙"]
    G --> O["추천 5개<br>job_id · 근거 · 우려"]
  end
  subgraph NEXT["그 다음 — 첨삭"]
    O -->|사용자가 하나 선택| P["job_id"]
    P --> T["첨삭 모듈<br>원문 전체 + 이력서"]
  end
  D -.-> V
  S -.-> T
