DATABASE_URL=postgresql://postgres@127.0.0.1:5432/lms
REDIS_URL=redis://127.0.0.1:6379/0
# 로컬: Celery 없이도 예약 공지 발행(1). 프로덕션+Celery면 0
LMS_INLINE_PUBLISH=1
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- 웹 (lms_react 빌드/개발) ---
# 로컬·같은 도메인 Nginx: /api
# API 전용 호스트면: https://api.example.com/api  (npm run build 전에 설정)
VITE_API_BASE=/api

# --- 취업 코치 · 챗봇 (AI 서버) ---
# 챗봇 · 공부방 노트 · 이력서 첨삭 · 공고 추천은 한 서버(cover_letter_rag/app/integrated.py)에 들어 있다.
# 로컬에서 함께 띄울 때:
#   python -m uvicorn app.integrated:app --app-dir cover_letter_rag --port 8100
# 두 값 모두 그 서버를 가리키면 된다. 비워 두면 그 기능만 「연결되어 있지 않습니다」로 답한다.
CHATBOT_URL=
JOBS_URL=

AWS_S3_BUCKET=skn34-4th-2team-lms
