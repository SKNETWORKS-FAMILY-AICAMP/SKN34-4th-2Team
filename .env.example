# 로컬 설정의 단일 원본. `copy .env.example .env` 후 값만 채운다. .env는 Git에 올리지 않는다.
#
# ── 키가 쓰이는 곳은 두 군데다 ─────────────────────────────────────────────
#  1) 로컬 Python 통합 서버(8000): 이 파일을 그대로 읽는다.
#  2) Firebase Functions(클라우드): 이 파일을 읽지 않는다.
#     - 일반 설정은 scripts/sync-functions-env.ps1 가 functions/.env 로 복사해 배포 시 주입한다.
#     - 아래 [Secret] 표시 키는 Secret Manager 에 따로 등록해야 한다. 스크립트가
#       functions/.env 에서 자동으로 제외하므로 같은 이름이 겹쳐 배포가 400으로 실패하지 않는다.
#
# ── Functions Secret 등록 (프로젝트에 한 번, 키가 바뀔 때만 다시) ─────────────
#   firebase functions:secrets:set OPENAI_API_KEY          # 공지 임베딩 + 성취도평가 문항 생성
#   firebase functions:secrets:set PINECONE_API_KEY2       # 공지 벡터 적재 (student 인덱스)
#   firebase functions:secrets:set DISCORD_BOT_TOKEN       # 디스코드 공지 동기화
#   firebase functions:secrets:set GOOGLE_FORM_WEBHOOK_SECRET
#   등록/변경 후에는 해당 함수를 다시 배포해야 반영된다:
#   firebase deploy --only functions:syncNoticeVector,functions:generateAssessmentQuestions
#
# ── Functions 배포 순서 ────────────────────────────────────────────────────
#   powershell -ExecutionPolicy Bypass -File scripts\sync-functions-env.ps1
#   firebase deploy --only functions
#   DISCORD_COHORT_ID / DATA_GO_KR_SERVICE_KEY 는 스크립트가 유지하므로 별도 작업 없음.

APP_ENV=local

# LLM / embeddings
# [Secret] Functions에서는 Secret Manager 값을 쓴다. 로컬 8000 서버는 이 값을 읽는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=medium

# LLMOps prompt versions (logged to aiGenerationLogs; no secrets)
JOB_CHAT_PROMPT_VERSION=job_chat_v1
JOB_RECOMMEND_PROMPT_VERSION=job_recommend_v1
RESUME_REVIEW_PROMPT_VERSION=resume_review_v1
# 문제생성은 Firebase Functions. sync-functions-env 후 deploy --only functions
ASSESSMENT_PROMPT_VERSION=assess_q_v2

# 공부방 노트 (통합 서버 8000, git clone). 모델이 비면 LMS_NODE_MODEL을 쓴다.
STUDY_NOTES_MODEL=gpt-5.6-luna
# STUDY_NOTES_CACHE_DIR=

# Job matching API CORS (local Flutter development only)
CORS_ALLOW_ORIGINS=http://localhost:5000
CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Pinecone job-posting index
# 채용공고 인덱스는 공지·정책 인덱스와 다른 계정을 쓴다. 아래 PINECONE_API_KEY2와
# 헷갈리지 않게 이름을 나눴다.
VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY1=
PINECONE_INDEX_NAME=job-posting
PINECONE_NAMESPACE=
PINECONE_INDEX_HOST=
PINECONE_DIMENSION=1536
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=skn34-3rd-2team
FIRESTORE_COHORTS_COLLECTION=cohorts
FIRESTORE_RESUMES_COLLECTION=resumes
FIRESTORE_AI_REVIEWS_COLLECTION=aiReviews

# Optional local path to the full job source used by detailed review.
# MATCHING_JOB_STORE_PATH=C:/path/to/job_store.sqlite

# Policy/FAQ ingestion (student chatbot)
OPENAI_PDF_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_CLASSIFICATION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_DIMENSION=1536

NOTION_TOKEN=

# 공지·정책(학생 챗봇) 인덱스 키. 채용공고·이력서 첨삭 쪽은 위의 PINECONE_API_KEY1이다.
# [Secret] 공지 → Pinecone 자동 적재(syncNoticeVector)는 Secret Manager 값을 쓴다.
#          로컬 8000 챗봇 서버는 이 값을 읽는다. 두 곳에 같은 키를 넣으면 된다.
PINECONE_API_KEY2=

# 공지·정책 인덱스 이름. 채용공고 쪽 PINECONE_INDEX_NAME과 다른 인덱스다.
PINECONE_STUDENT_INDEX_NAME=student

# Firebase Functions 전용 (Functions 에서만 읽음, 로컬 서버는 무시)
# 디스코드 공지를 동기화할 기수 ID
DISCORD_COHORT_ID=cohort_34
# 공공데이터포털 국가자격 시험일정 API 일반 인증키(Decoding). 비워도 배포는 된다.
DATA_GO_KR_SERVICE_KEY=

# LMS chatbot models
LMS_SUPERVISOR_MODEL=gpt-5.6-sol
LMS_NODE_MODEL=gpt-5.6-sol
# 학생 챗봇 프롬프트 버전 (aiGenerationLogs.promptVersion). 비우면 student_chatbot_v2
LMS_CHATBOT_PROMPT_VERSION=student_chatbot_v2

# LMS chatbot tracing (선택). 코드에서 강제하지 않으므로 트레이싱하려면 여기 4개를 모두 채운다.
# LANGSMITH_API_KEY가 비어 있으면 LANGSMITH_TRACING=false 로 두어야 401 경고가 나지 않는다.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=SKN34-3rd-2Team
