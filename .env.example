DATABASE_URL=postgresql://postgres@127.0.0.1:5432/lms
# PostgreSQL / RDS: 두 EC2의 실제 .env에 동일한 DB 접속값을 각각 설정한다.
# 로컬에서는 DB_HOST를 비워 DATABASE_URL을 사용한다. DB_HOST가 있으면 DB_*가 우선한다.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
REDIS_URL=redis://127.0.0.1:6379/0
# Django 배포 Compose는 api/worker/beat의 REDIS_URL을 같은 호스트의 redis 서비스로 덮어쓴다.
# 로컬: Celery 없이도 예약 공지 발행(1). 프로덕션+Celery면 0
LMS_INLINE_PUBLISH=1
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- 웹 (lms_react 빌드/개발) ---
# 로컬·같은 도메인 Nginx: /api
# API 전용 호스트면: https://api.example.com/api  (npm run build 전에 설정)
VITE_API_BASE=/api

# 값을 따옴표로 감싸지 말 것. Django 는 따옴표를 벗기지만 docker --env-file 은
# 값의 일부로 본다 — 키가 따옴표째 넘어가 401 이 난다.
#
# 기본값이 있는 설정은 「# 키=기본값」 주석으로 둔다. 바꿀 때만 주석을 푼다.
# 「키=」처럼 빈 값으로 두면 기본값이 아니라 빈 문자열이 들어가는 설정이 있다(OPENAI_MODEL 등).

# --- 취업 코치 · 챗봇 (AI 서버) ---
# 챗봇 · 공부방 노트 · 이력서 첨삭 · 공고 추천은 한 서버(cover_letter_rag/app/integrated.py)에 들어 있다.
# 로컬에서 함께 띄울 때:
#   python -m uvicorn app.integrated:app --app-dir cover_letter_rag --port 8001
# 네 값 모두 그 서버를 가리키면 된다(로컬이면 http://127.0.0.1:8001).
# Django EC2의 실제 .env에는 FastAPI EC2의 private address:8001을 사용한다.
# Django 배포 Compose는 비어 있는 URL/토큰으로 시작하지 않도록 검사한다.
# 로컬에서 비워 두면 그 기능만 「연결되어 있지 않습니다」로 답한다.
# 코드를 받은(pull) 뒤에는 AI 서버를 다시 띄워야 새 창구가 생긴다. Django 는 개발 모드면 알아서 다시 뜬다.
CHATBOT_URL=
JOBS_URL=
# 이력서 첨삭 · 공고 맞춤 지원(요건 정리 · 문항 답변 · 캡처/PDF 문항 읽기)만 다른 곳에 띄울 때. 비우면 JOBS_URL 과 같은 서버.
RESUME_REVIEW_URL=
# 공부방 노트만 다른 곳에 띄울 때. 비우면 JOBS_URL(없으면 CHATBOT_URL)과 같은 서버를 쓴다.
STUDY_NOTES_URL=
# Django와 AI 서비스에 같은 비밀값을 별도로 주입한다. 저장소에 실제 값 커밋 금지.
LMS_AI_SHARED_TOKEN=
# 관리자 AI 어시스턴트 모델 — 도구 호출(function tools)을 Chat Completions 로 쓸 수 있는 모델(예: gpt-4o-mini).
# 비우면 OPENAI_MODEL. gpt-6-luna 처럼 추론이 켜진 모델은 도구 호출을 거절한다.
ADMIN_ASSISTANT_MODEL=
# 비공개 수업 저장소를 읽을 GitHub 토큰(AI 서버가 쓴다). 읽기 전용 fine-grained 토큰 — Contents: Read, Metadata: Read.
# 기수 조직 저장소는 토큰 주인이 조직 멤버면 되고, 강사 개인 저장소는 토큰 주인을 협업자(읽기)로 초대한다.
# 로컬에선 비워 둬도 이 PC 의 git 로그인으로 돈다. 배포 서버(컨테이너)엔 로그인이 없으니 반드시 넣는다.
GITHUB_TOKEN=
# 공고 저장소(jobs 스키마)는 AI 서버도 위의 DB_HOST · DB_NAME · DB_USER · DB_PASSWORD(RDS)로 붙는다.
# 공고 맞춤 지원 · 추천 · 첨삭이 같은 공고를 보려면 Django 와 같은 RDS 값을 둔다.
# 비어 있으면 첨삭 · 공고 맞춤 지원(요건 · 자소서 만들기 · 문항 답변) 요청이 「Firebase configuration unavailable」로 막힌다.
# 저장은 이제 Postgres 이고 이름만 남은 설정이라, 아무 프로젝트 이름이나 넣는다.
FIREBASE_PROJECT_ID=
# 브라우저가 AI 서버를 바로 부를 때 허용할 출처(쉼표로 구분) · 정규식. 보통 Django 가 대신 부르므로 비워 둔다.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
# 첨삭 서버 설정에 남은 이름들. 지금 동작에 영향이 없어 바꿀 일이 없다.
# APP_ENV=local
# FIRESTORE_COHORTS_COLLECTION=cohorts
# FIRESTORE_RESUMES_COLLECTION=resumes
# FIRESTORE_AI_REVIEWS_COLLECTION=aiReviews

# --- OpenAI (AI 서버 · Django 공지 벡터 · vectordb 적재) ---
# 첨삭 · 공고 추천 · 코치 대화 · 공고 맞춤 지원(요건 정리 · 문항 답변 · 캡처/PDF 문항 읽기) · 챗봇 · 공부방 노트 · 연습장.
# 캡처 읽기는 이미지를 읽을 수 있는 모델이어야 한다.
OPENAI_API_KEY=
# 첨삭 · 공고 추천 · 공고 맞춤 지원의 모델과 추론 강도(none · low · medium · high · xhigh · max)
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=medium
# 학생 챗봇의 supervisor · 노드 모델
# LMS_SUPERVISOR_MODEL=gpt-5.6-luna
# LMS_NODE_MODEL=gpt-5.6-luna
# 공부방 노트 모델. 없으면 LMS_NODE_MODEL, 그것도 없으면 gpt-6-luna
# STUDY_NOTES_MODEL=gpt-6-luna
# 연습장(복습 문제 출제 · 튜터) 모델. 없으면 각 기능의 기본 모델
# PRACTICE_MODEL=
# 임베딩 — 학생 챗봇 · 공지 벡터 · 공고 코치 · vectordb 적재가 쓴다. 차원은 Pinecone 인덱스 차원과 같아야 한다.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSION=1536
# 정책 문서 적재(vectordb/policy_ingestion.py)의 분류 · PDF 추출 모델. 없으면 OPENAI_MODEL
# OPENAI_CLASSIFICATION_MODEL=
# OPENAI_PDF_EXTRACTION_MODEL=

# --- Pinecone (벡터 검색) ---
# 채용공고 인덱스 키 — 공고 추천 · 코치 대화 · 밤 수집 동기화. 학생 쪽과 프로젝트가 달라 키가 따로다.
PINECONE_API_KEY1=
# 학생 챗봇 · 공지 · 정책 · 레퍼런스 인덱스 키(chatbot · Django 공지 벡터 · vectordb 적재)
PINECONE_API_KEY2=
# 채용공고 인덱스의 namespace. 비우면 기본 namespace
PINECONE_NAMESPACE=
# 인덱스 이름을 바꿀 때만. 채용공고는 PINECONE_INDEX, 학생 쪽은 PINECONE_STUDENT_INDEX_NAME 으로 읽는다.
# PINECONE_INDEX=job-posting
# PINECONE_STUDENT_INDEX_NAME=student
# 정책 인덱스를 새로 만들 때(vectordb/policy_ingestion.py)의 위치
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_INDEX_NAME · PINECONE_DIMENSION · PINECONE_INDEX_HOST · VECTOR_STORE_PROVIDER 는 지금 코드가 읽지 않는다
# (예전 설정 · 옛 자기소개서 RAG). 넣지 않아도 된다.

# --- LangSmith (LLM 추적 · 품질 확인, 선택) ---
# 켜면 LLM 입력 · 출력이 LangSmith(국외 서버)로 간다. 첨삭 서버는 보내기 전에 이름 · 연락처를 가린다(trace_privacy.py).
# 내용까지 보는 추적은 데모 · 테스트 계정으로만 한다. 운영은 LANGSMITH_HIDE_INPUTS=true · LANGSMITH_HIDE_OUTPUTS=true 로 내용을 보내지 않는다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 비우면 LangSmith 의 default 프로젝트
# LANGSMITH_PROJECT=
# 개인정보 가리기를 끌 때만 false
# LANGSMITH_ANONYMIZE=true

# --- 운영 기록용 프롬프트 버전 (LLMOps 화면에 남는 값. 지시문을 바꿀 때만 올린다) ---
# LMS_CHATBOT_PROMPT_VERSION=student_chatbot_v2
# JOB_CHAT_PROMPT_VERSION=job_chat_v1
# JOB_RECOMMEND_PROMPT_VERSION=job_recommend_v1
# RESUME_REVIEW_PROMPT_VERSION=resume_review_v1

# --- 정책 문서 (Notion) ---
# 정책 원문을 Notion 에서 가져올 때(lms_api import_policy_sources · vectordb/policy_ingestion.py). 읽기 권한만 준 통합 토큰.
NOTION_TOKEN=

# --- 공휴일 (출석 달력) ---
# 공공데이터포털 「한국천문연구원 특일 정보」 활용 신청으로 받은 키. scripts/fetch_holidays.py 가 쓴다.
# 자격 시험 일정 키(DATA_GO_KR_SERVICE_KEY)와는 따로 받은 다른 키다 — 합치지 않는다.
DATA_GO_KR_API_KEY=
# 「한국산업인력공단_국가자격 시험일정 조회 서비스」 일반 인증키(Decoding). lms_api/lms/external_feeds.py 가
# 하루에 한 번 받아 system_cache 에 둔다(수동: python manage.py sync_qual_exams). 없으면 마지막으로 받은 일정을 보여 준다.
DATA_GO_KR_SERVICE_KEY=

# --- 공부방 이번 주 커리큘럼 YouTube 추천 ---
# Google Cloud 「YouTube Data API v3」 API 키. 기수 · 주마다 12시간 캐시(검색 한 번에 쿼터 100, 하루 1만).
YOUTUBE_API_KEY=

# --- Firebase Functions (functions/ — 디스코드 공지 · 성취도 출제) ---
# scripts/sync-functions-env.ps1 이 functions/.env 로 옮긴다.
DISCORD_COHORT_ID=cohort_34
# ASSESSMENT_PROMPT_VERSION=assess_q_v2

# --- 파일 저장소 / 일회성 Firebase Storage 이전 ---
# AWS 자격증명은 환경변수, AWS profile 또는 IAM role로 제공한다. 로컬에서 환경변수로 줄 때:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# 배포 이미지 — Django/AI EC2의 각 Compose가 사용한다
ECR_IMAGE=
ECR_AI_IMAGE=
