DATABASE_URL=postgresql://postgres@127.0.0.1:5432/lms
# Optional RDS configuration. Set DB_HOST, DB_NAME, DB_USER and DB_PASSWORD
# together to override DATABASE_URL. DB_SSLMODE defaults to require.
# DB_HOST=your-rds-endpoint.amazonaws.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=project_admin
# DB_PASSWORD=replace-with-secret
# DB_SSLMODE=require
REDIS_URL=redis://127.0.0.1:6379/0
# 로컬: Celery 없이도 예약 공지 발행(1). 프로덕션+Celery면 0
LMS_INLINE_PUBLISH=1
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- 웹 (lms_react 빌드/개발) ---
# 로컬·같은 도메인 Nginx: /api
# API 전용 호스트면: https://api.example.com/api  (npm run build 전에 설정)
VITE_API_BASE=/api

# --- 챗봇 ---
CHATBOT_URL=
# 로컬: http://127.0.0.1:8001  (uvicorn chatbot.main:app --port 8001)
# Django와 AI 서비스에 같은 비밀값을 별도로 주입한다. 저장소에 실제 값 커밋 금지.
LMS_AI_SHARED_TOKEN=

# --- 파일 저장소 / 일회성 Firebase Storage 이전 ---
# AWS 자격증명은 환경변수, AWS profile 또는 IAM role로 제공한다.
# AWS_S3_BUCKET=your-s3-bucket
# AWS_REGION=us-east-1
