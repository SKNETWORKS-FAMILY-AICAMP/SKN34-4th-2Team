{
  "expo": {
    "name": "PLAYDATA LXP",
    "slug": "lms-mobile",
    "scheme": "lms",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.FOvia.lxp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.FOvia.lxp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "기록실 · 퀘스트 증빙 사진을 찍으려면 카메라 권한이 필요합니다.",
          "photosPermission": "기록실 · 퀘스트 증빙 사진을 고르려면 사진 보관함 권한이 필요합니다."
        }
      ],
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0284c7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7194b1b9-3f5f-4138-b8a0-0547b445a10a"
      }
    }
  }
}
