rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ──

    /// 인증 여부
    function isAuthenticated() {
      return request.auth != null;
    }

    /// users/{uid} 문서 데이터 조회
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// 활성 사용자 여부
    function isActiveUser() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().isActive == true;
    }

    /// 관리자 여부
    function isAdmin() {
      return isActiveUser() && getUserData().role == 'admin';
    }

    /// 특정 기수 소속 여부
    function belongsToCohort(cohortId) {
      return isActiveUser() && getUserData().cohortId == cohortId;
    }

    /// 관리자이거나 해당 기수 소속
    function canAccessCohort(cohortId) {
      return isAdmin() || belongsToCohort(cohortId);
    }

    /// 기수 자리배치 확정 여부
    function seatingPublished(cohortId) {
      let metaPath = /databases/$(database)/documents/cohorts/$(cohortId)/seatingMeta/default;
      return exists(metaPath)
        && get(metaPath).data.publishedRoomId != null
        && exists(/databases/$(database)/documents/cohorts/$(cohortId)/seatingAssignments/$(get(metaPath).data.publishedRoomId))
        && get(/databases/$(database)/documents/cohorts/$(cohortId)/seatingAssignments/$(get(metaPath).data.publishedRoomId)).data.status == 'published';
    }

    function seatingPublishedLegacy(cohortId) {
      return exists(/databases/$(database)/documents/cohorts/$(cohortId)/seating/assignment)
        && get(/databases/$(database)/documents/cohorts/$(cohortId)/seating/assignment).data.status == 'published';
    }

    function canReadSeatingAsStudent(cohortId) {
      return belongsToCohort(cohortId) && (seatingPublished(cohortId) || seatingPublishedLegacy(cohortId));
    }

    /// 본인 문서 여부
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── users 컬렉션 ──

    match /users/{userId} {
      // 본인 프로필 읽기 / 관리자는 전체 읽기
      allow read: if isOwner(userId) || isAdmin();

      // 학생: 본인 프로필 일부 필드만 수정 (skills, motto, socialLinks)
      allow update: if isOwner(userId)
        && isActiveUser()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'cohortId', 'cohortName', 'isActive', 'mileageBalance', 'email']);

      // 관리자: 전체 수정
      allow update: if isAdmin();

      // 계정 생성은 Cloud Functions(Admin SDK)만 — 클라이언트 create 금지
      allow create: if false;
      allow delete: if isAdmin();

      // 개인 TODO subcollection
      match /todos/{todoId} {
        allow read, write: if isOwner(userId) && isActiveUser();
      }
    }

    // ── cohorts 컬렉션 ──

    match /cohorts/{cohortId} {
      // 기수 메타: 소속 학생/관리자 읽기, 관리자만 쓰기
      allow read: if belongsToCohort(cohortId) || isAdmin();
      allow write: if isAdmin();

      // ── 시간표 ──
      match /schedules/{scheduleId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 자리 배치 (레거시) ──
      match /seating/{docId} {
        allow read: if isAdmin() || canReadSeatingAsStudent(cohortId);
        allow write: if isAdmin();
      }

      match /seatingRooms/{roomId} {
        allow read: if isAdmin()
          || (canReadSeatingAsStudent(cohortId)
            && exists(/databases/$(database)/documents/cohorts/$(cohortId)/seatingMeta/default)
            && roomId == get(/databases/$(database)/documents/cohorts/$(cohortId)/seatingMeta/default).data.publishedRoomId);
        allow write: if isAdmin();
      }

      match /seatingAssignments/{roomId} {
        allow read: if isAdmin()
          || (canReadSeatingAsStudent(cohortId) && resource.data.status == 'published');
        allow write: if isAdmin();
      }

      match /seatingMeta/{docId} {
        allow read: if belongsToCohort(cohortId) || isAdmin();
        allow write: if isAdmin();
      }

      // ── 출결 ──
      match /attendances/{attendanceId} {
        allow read: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // ── 공지사항 ──
      match /notices/{noticeId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 예약 공지 ──
      match /scheduledNotices/{scheduledId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      // ── 소통 피드 ──
      match /posts/{postId} {
        allow read: if belongsToCohort(cohortId);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.authorId == request.auth.uid);

        match /comments/{commentId} {
          allow read: if belongsToCohort(cohortId);
          allow create: if belongsToCohort(cohortId)
            && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if belongsToCohort(cohortId)
            && (isAdmin() || resource.data.authorId == request.auth.uid);
        }
      }

      // ── 1:1 Q&A ──
      match /qna/{threadId} {
        allow read: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.studentId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.studentId == request.auth.uid;
        allow update: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.studentId == request.auth.uid);

        match /messages/{messageId} {
          allow read: if belongsToCohort(cohortId)
            && (isAdmin()
              || get(/databases/$(database)/documents/cohorts/$(cohortId)/qna/$(threadId)).data.studentId
                == request.auth.uid);
          allow create: if belongsToCohort(cohortId)
            && request.resource.data.senderId == request.auth.uid;
        }
      }

      // ── 강의 자료 ──
      match /materials/{materialId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();
      }

      // ── 과제 ──
      match /assignments/{assignmentId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();

        match /submissions/{submissionUserId} {
          allow read: if belongsToCohort(cohortId)
            && (isAdmin() || submissionUserId == request.auth.uid);
          allow create, update: if belongsToCohort(cohortId)
            && submissionUserId == request.auth.uid;
          allow delete: if isAdmin();
        }
      }

      // ── 이력서 ──
      match /resumes/{resumeId} {
        allow read: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if belongsToCohort(cohortId)
          && resource.data.userId == request.auth.uid;
        allow delete: if belongsToCohort(cohortId)
          && resource.data.userId == request.auth.uid;

        match /feedback/{feedbackId} {
          allow read: if belongsToCohort(cohortId)
            && (isAdmin()
              || get(/databases/$(database)/documents/cohorts/$(cohortId)/resumes/$(resumeId)).data.userId
                == request.auth.uid);
          allow write: if isAdmin();
        }
      }

      // ── 마일리지 거래 ──
      match /mileageTransactions/{txId} {
        allow read: if belongsToCohort(cohortId)
          && (isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      // ── 마일리지 설정 ──
      match /mileageSettings/{docId} {
        allow read: if belongsToCohort(cohortId) || isAdmin();
        allow write: if isAdmin();
      }

      // ── 마일리지 상품 ──
      match /mileageProducts/{productId} {
        allow read: if belongsToCohort(cohortId) || isAdmin();
        allow write: if isAdmin();
      }

      // ── 구매 요청 ──
      match /purchaseRequests/{requestId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      // ── 마일리지 장바구니 ──
      match /mileageCart/{userId} {
        allow read, write: if belongsToCohort(cohortId)
          && request.auth.uid == userId;
      }

      // ── 주간 필수 학습 ──
      match /weeklyTasks/{taskId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();
      }

      match /userProgress/{progressUserId} {
        allow read: if belongsToCohort(cohortId)
          && (isAdmin() || progressUserId == request.auth.uid);
        allow create, update: if belongsToCohort(cohortId)
          && progressUserId == request.auth.uid;
      }

      // ── 제출/승인 (블로그 등) ──
      match /submissions/{submissionId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid);
        allow create: if belongsToCohort(cohortId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin()
          || (belongsToCohort(cohortId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.status == resource.data.status);
      }

      // ── 커리큘럼 ──
      match /curriculum/{docId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId)
            && docId == 'meta'
            && resource.data.published == true);
        allow write: if isAdmin();
      }

      match /curriculumWeeks/{weekId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId) && resource.data.published == true);
        allow write: if isAdmin();
      }

      match /curriculumDays/{dayId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId) && resource.data.published == true);
        allow write: if isAdmin();
      }

      match /curriculumProgress/{userId} {
        allow read: if isAdmin()
          || (belongsToCohort(cohortId) && userId == request.auth.uid);
        allow create, update: if belongsToCohort(cohortId)
          && userId == request.auth.uid;
      }

      // ── Play 미션 ──
      match /playMissions/{missionId} {
        allow read: if belongsToCohort(cohortId);
        allow write: if isAdmin();
      }
    }
  }
}
